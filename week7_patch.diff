-# Existing logic
+#!/bin/bash
+
+# Load endpoints from deployment outputs if provided
+if [ -f deployment_outputs.json ]; then
+  OCR_URL=$(jq -r '.OCRUrl' deployment_outputs.json)
+  SLACK_URL=$(jq -r '.SlackActionsUrl' deployment_outputs.json)
+  INVOICE_POST_URL=$(jq -r '.InvoicePostUrl' deployment_outputs.json)
+fi
+
+echo "Using endpoints:"
+echo " OCR_URL=$OCR_URL"
+echo " SLACK_URL=$SLACK_URL"
+echo " INVOICE_POST_URL=$INVOICE_POST_URL"
+
+# OCR endpoint test
+if [ -n "$OCR_URL" ]; then
+  echo "Testing OCR endpoint..."
+  resp=$(curl -s -X POST "$OCR_URL" -H "Content-Type: application/json" -d '{"pdf_base64":"dGhpcyBpcyBhIHRlc3QgcGRm"}')
+  echo "$resp" | grep -q '"vendor"' && echo "✓ OCR response contains vendor" || echo "✗ OCR response missing vendor"
+fi
+
+# Slack actions test
+if [ -n "$SLACK_URL" ]; then
+  echo "Testing Slack actions endpoint..."
+  timestamp=$(date +%s)
+  payload='payload={"type":"block_actions","actions":[{"action_id":"approve_invoice","value":"1"}],"user":{"id":"U123"},"token":"verification"}'
+  signature=""
+  if [ -n "$SLACK_SECRET" ]; then
+    signature=$(printf "v0:%s:%s" "$timestamp" "$payload" | openssl dgst -sha256 -hmac "$SLACK_SECRET" -hex | sed 's/^.* //')
+  fi
+  resp=$(curl -s -X POST "$SLACK_URL" \
+    -H "Content-Type: application/x-www-form-urlencoded" \
+    -H "X-Slack-Request-Timestamp: $timestamp" \
+    -H "X-Slack-Signature: v0=$signature" \
+    --data "$payload")
+  echo "$resp" | grep -q '"ok"' && echo "✓ Slack actions ok" || echo "✗ Slack actions failed"
+fi
+
+# Invoice post test
+if [ -n "$INVOICE_POST_URL" ]; then
+  echo "Testing invoice post endpoint..."
+  resp=$(curl -s -X POST "$INVOICE_POST_URL" -H "Content-Type: application/json" -d '{"invoice_id":1}')
+  echo "$resp" | grep -q '"posted"' && echo "✓ Invoice post ok" || echo "✗ Invoice post failed"
+fi

diff --git a/README.md b/README.md
index abcdef1..abcdef2 100644
--- a/README.md
+++ b/README.md
@@
 The ``serverless deploy`` command will output the URL of the OCR and
 Slack API endpoints.  These endpoints are used by the smoke test
 script.
+
+## Staging Deployment and Validation
+
+To deploy a staging stack, configure AWS credentials and run:
+
+```bash
+serverless deploy --stage staging
+```
+
+Serverless will deploy the OCR, Slack actions, and invoice post Lambdas, create the archive S3 bucket if not provided, and tag all resources with ``project=invoice-hawk`` and ``env=staging``. After deployment, you can retrieve endpoint URLs using:
+
+```bash
+serverless info --stage staging --format json > deployment_outputs.json
+```
+
+### Verifying the staging environment
+
+Use the updated ``scripts/smoke.sh`` to validate the deployment. Ensure ``deployment_outputs.json`` is in the current directory or set ``OCR_URL``, ``SLACK_URL``, and ``INVOICE_POST_URL`` environment variables. The script will:
+
+1. Send a base64‑encoded PDF to the OCR endpoint and check for expected fields.
+2. Send a signed Slack action payload to the Slack actions endpoint and expect ``{ \"ok\": true }``.
+3. Post to the invoice post endpoint and expect a ``posted`` response with an ``external_id``.
+
+### Rollback and log inspection
+
+To remove the staging stack:
+
+```bash
+serverless remove --stage staging
+```
+
+Logs are written to CloudWatch under ``/aws/lambda/invoice-hawk-staging-ocrWorker``, ``...-slackActions``, and ``...-invoicePost``. Use the AWS console to inspect logs for debugging.

