diff --git a/scripts/smoke.sh b/scripts/smoke.sh
--- a/scripts/smoke.sh
+++ b/scripts/smoke.sh
@@
 if [ -n "$INVOICE_POST_URL" ]; then
   echo "Testing invoice post endpoint..."
-  resp=$(curl -s -X POST "$INVOICE_POST_URL" -H 'Content-Type: application/json' -d '{"invoice_id":1}')
-  echo "$resp" | grep -q '"posted"' && echo "✓ Invoice post ok" || echo "✗ Invoice post failed"
+  resp=$(curl -s -X POST "$INVOICE_POST_URL" -H 'Content-Type: application/json' -d '{"invoice_id":1}')
+  if echo "$resp" | grep -q '"posted"'; then
+    echo "✓ Invoice post returned posted"
+  elif echo "$resp" | grep -q '"error"' || echo "$resp" | grep -q '"Invoice not found"'; then
+    echo "⚠️ Invoice post endpoint reachable but invoice was not found"
+  else
+    echo "✗ Invoice post endpoint failed"
+  fi
 fi

